# Environment variables (copy to .env and fill in)

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Required for ingest/judge/context/settle after anon write policies were revoked
SUPABASE_SERVICE_ROLE_KEY=

# External APIs
API_FOOTBALL_KEY=
THE_ODDS_API_KEY=

# LLM / Observability
OPENAI_API_KEY=
HELICONE_API_KEY=

# Payments
ASAAS_API_KEY=
ASAAS_WEBHOOK_SECRET=

# Firebase (push notifications)
FIREBASE_PROJECT_ID=

# Web → API
SCOUTER_API_PORT=8080
SCOUTER_API_ORIGIN=http://127.0.0.1:8080
